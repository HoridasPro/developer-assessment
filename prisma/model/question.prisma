

model Question {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        QuestionType
  category    String
  difficulty  Difficulty
  marks       Float
  option      String?

  options     QuestionOption[]

  assessments AssessmentQuestion[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("questions")
}